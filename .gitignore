# ===========================================
# Go Backend
# ===========================================

# Docker data directories - 数据库持久化数据
backend/data/

# Logs - 日志文件
backend/logs/
*.log

# Build outputs - 编译输出
backend/**/target/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Uploaded files - 用户上传文件
backend/api/uploads/

# Temporary directories - 临时目录
backend/user/D__/

# Go workspace files (可选保留)
# go.work
# go.work.sum

# Test coverage
*.out
coverage.txt

# ===========================================
# Vue Frontend
# ===========================================

# Dependencies
frontend/node_modules/

# Build output
frontend/dist/

# npm/yarn debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
frontend/.idea
frontend/.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ===========================================
# Database
# ===========================================

# Database files (should not be committed)
database/*.sql.bak
database/*.sql.gz

# ===========================================
# General
# ===========================================

# IDE
.idea/
.vscode/
*.swp
*.swo
*.iml
.project
.classpath
.settings/

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Environment files
.env
.env.local
.env.*.local
*.local

# Temporary files
*.tmp
*.temp
*.bak
*.cache
