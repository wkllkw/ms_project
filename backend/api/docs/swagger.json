{
    "swagger": "2.0",
    "info": {
        "description": "基于 Go + Gin + Vue 的企业级任务协作系统后端API\u003cbr/\u003e\n功能模块: 项目管理 | 任务看板 | 甘特图 | 日程安排 | 文件管理 | 成员权限 | 实时通知",
        "title": "MS Project 任务协作平台 API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "MS Project API Support",
            "email": "support@example.com"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0"
    },
    "host": "localhost:18000",
    "basePath": "/",
    "paths": {
        "/file/upload": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "上传文件到项目，支持图片/文档/视频等类型",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "file"
                ],
                "summary": "上传文件",
                "parameters": [
                    {
                        "type": "file",
                        "description": "要上传的文件",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "项目加密ID",
                        "name": "projectCode",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "返回文件信息(code/title/fileType/fileSize/fileUrl)",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    },
                    "400": {
                        "description": "参数错误或文件过大",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    }
                }
            }
        },
        "/project/analysis": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "获取项目的任务统计、进度分析、成员工作量等数据",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "project"
                ],
                "summary": "项目数据分析",
                "parameters": [
                    {
                        "type": "string",
                        "description": "项目加密ID",
                        "name": "code",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "返回项目统计数据",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    }
                }
            }
        },
        "/project/edit": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "修改项目名称、描述、封面等信息",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "project"
                ],
                "summary": "编辑项目",
                "parameters": [
                    {
                        "type": "string",
                        "description": "项目加密ID",
                        "name": "code",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "项目名称",
                        "name": "name",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "项目描述",
                        "name": "description",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "项目封面URL",
                        "name": "cover",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "返回编辑后的项目数据",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    }
                }
            }
        },
        "/project/index": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "查询当前用户可访问的项目列表（支持分页和关键词搜索）",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "project"
                ],
                "summary": "项目列表",
                "parameters": [
                    {
                        "type": "string",
                        "description": "项目名称搜索",
                        "name": "keyword",
                        "in": "formData"
                    },
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "页码",
                        "name": "page",
                        "in": "formData"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "每页条数",
                        "name": "pageSize",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "返回项目列表和分页信息",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    }
                }
            }
        },
        "/project/read": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "获取项目完整信息（含成员列表、统计等）",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "project"
                ],
                "summary": "项目详情",
                "parameters": [
                    {
                        "type": "string",
                        "description": "项目加密ID",
                        "name": "code",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "返回项目完整数据",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    },
                    "404": {
                        "description": "项目不存在",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    }
                }
            }
        },
        "/project/save": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "创建新的协作项目",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "project"
                ],
                "summary": "创建项目",
                "parameters": [
                    {
                        "type": "string",
                        "description": "项目名称",
                        "name": "name",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "项目描述",
                        "name": "description",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "项目封面URL",
                        "name": "cover",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "项目代号前缀",
                        "name": "prefix",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "返回新项目加密ID",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    },
                    "400": {
                        "description": "参数错误",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    }
                }
            }
        },
        "/project/task": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "根据项目编码分页查询任务列表，支持按状态/阶段/优先级等条件筛选",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "task"
                ],
                "summary": "任务列表查询",
                "parameters": [
                    {
                        "type": "string",
                        "description": "项目加密ID",
                        "name": "projectCode",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "是否已删除(0/1)",
                        "name": "deleted",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "看板阶段编码",
                        "name": "stageCode",
                        "in": "formData"
                    },
                    {
                        "type": "integer",
                        "description": "任务状态",
                        "name": "status",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "关键词搜索",
                        "name": "keyword",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功返回任务列表和分页信息",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    },
                    "400": {
                        "description": "参数错误",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    }
                }
            }
        },
        "/project/task/createComment": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "在指定任务下添加评论",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "task"
                ],
                "summary": "创建任务评论",
                "parameters": [
                    {
                        "type": "string",
                        "description": "任务加密ID",
                        "name": "code",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "评论内容",
                        "name": "content",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "返回新评论ID",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    },
                    "400": {
                        "description": "参数错误",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    }
                }
            }
        },
        "/project/task/edit": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "修改已有任务的名称、描述、优先级、截止时间等信息",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "task"
                ],
                "summary": "编辑任务",
                "parameters": [
                    {
                        "type": "string",
                        "description": "任务加密ID",
                        "name": "code",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "任务名称",
                        "name": "name",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "任务描述",
                        "name": "description",
                        "in": "formData"
                    },
                    {
                        "type": "integer",
                        "description": "优先级(0-3)",
                        "name": "priority",
                        "in": "formData"
                    },
                    {
                        "type": "integer",
                        "description": "截止时间戳(毫秒)",
                        "name": "end_time",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "执行者账号",
                        "name": "assign_to",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "返回编辑后的任务数据",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    },
                    "400": {
                        "description": "参数错误",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    }
                }
            }
        },
        "/project/task/read": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "获取单个任务的完整详情（含评论、工时记录、附件等）",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "task"
                ],
                "summary": "任务详情",
                "parameters": [
                    {
                        "type": "string",
                        "description": "任务加密ID",
                        "name": "code",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "返回任务完整数据",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    },
                    "404": {
                        "description": "任务不存在",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    }
                }
            }
        },
        "/project/task/save": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "在指定项目中创建新任务，支持设置优先级/截止时间/执行者等",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "task"
                ],
                "summary": "创建新任务",
                "parameters": [
                    {
                        "type": "string",
                        "description": "任务名称",
                        "name": "name",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "项目加密ID",
                        "name": "projectCode",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "任务描述",
                        "name": "description",
                        "in": "formData"
                    },
                    {
                        "type": "integer",
                        "description": "优先级(0-3)",
                        "name": "priority",
                        "in": "formData"
                    },
                    {
                        "type": "integer",
                        "description": "截止时间戳(毫秒)",
                        "name": "end_time",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "执行者账号",
                        "name": "assign_to",
                        "in": "formData"
                    },
                    {
                        "type": "integer",
                        "description": "看板阶段编码",
                        "name": "stage_code",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "返回新创建的任务ID",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    },
                    "400": {
                        "description": "参数错误",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    }
                }
            }
        },
        "/project/task/uploadFile": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "上传文件作为任务附件，保存到本地磁盘并记录到数据库",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "task"
                ],
                "summary": "上传任务附件",
                "parameters": [
                    {
                        "type": "file",
                        "description": "附件文件(最大30MB)",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "项目加密ID",
                        "name": "projectCode",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "返回文件信息(file_name/file_size/file_url/file_type)",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    },
                    "400": {
                        "description": "参数错误或文件过大",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    }
                }
            }
        },
        "/user/login": {
            "post": {
                "description": "使用账号密码登录系统，返回Token和用户信息",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "user"
                ],
                "summary": "用户登录",
                "parameters": [
                    {
                        "description": "登录信息(account/password)",
                        "name": "account",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/user.LoginReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "返回用户信息和Token",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    },
                    "400": {
                        "description": "账号或密码错误",
                        "schema": {
                            "$ref": "#/definitions/common.Result"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "common.Result": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "data": {},
                "msg": {
                    "type": "string"
                }
            }
        },
        "user.LoginReq": {
            "type": "object",
            "properties": {
                "account": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "ApiKeyAuth": {
            "description": "Bearer Token 认证（登录后获取）",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    },
    "tags": [
        {
            "description": "项目管理相关接口",
            "name": "project"
        },
        {
            "description": "任务管理相关接口（CRUD/分配/评论/工时/附件）",
            "name": "task"
        },
        {
            "description": "文件上传与管理接口",
            "name": "file"
        },
        {
            "description": "用户认证与个人设置接口",
            "name": "user"
        },
        {
            "description": "系统通知接口",
            "name": "notify"
        }
    ]
}